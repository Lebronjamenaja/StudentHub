rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'buddykung2019@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation blueprints
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'status']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'status', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.role in ['student', 'admin'] &&
        data.status in ['active', 'suspended'];
    }

    function isValidTask(data) {
      return data.keys().hasAll(['id', 'ownerUid', 'title', 'subject', 'dueDate', 'priority', 'status']) &&
        data.keys().hasOnly(['id', 'ownerUid', 'title', 'subject', 'description', 'dueDate', 'priority', 'status', 'submissionUrl', 'submissionNote', 'submittedAt', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 100 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
        data.dueDate is string && data.dueDate.size() <= 50 &&
        data.priority in ['Low', 'Medium', 'High'] &&
        data.status in ['Pending', 'In Progress', 'Completed'] &&
        (!('submissionUrl' in data) || (data.submissionUrl is string && data.submissionUrl.size() <= 500)) &&
        (!('submissionNote' in data) || (data.submissionNote is string && data.submissionNote.size() <= 1000)) &&
        (!('submittedAt' in data) || (data.submittedAt is string && data.submittedAt.size() <= 50));
    }

    function isValidFeedback(data) {
      return data.keys().hasAll(['id', 'userUid', 'title', 'category', 'details']) &&
        data.keys().hasOnly(['id', 'userUid', 'userEmailMasked', 'title', 'category', 'details', 'status', 'createdAt']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.userUid is string && data.userUid.size() >= 1 && data.userUid.size() <= 128 &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 200 &&
        data.category in ['bug', 'feature', 'ui', 'security', 'general'] &&
        data.details is string && data.details.size() >= 5 && data.details.size() <= 2000;
    }

    // Health / Connection Test
    match /test/{testId} {
      allow read: if true;
    }

    // Administrators registry
    match /admins/{adminUid} {
      allow read: if isSignedIn() && (request.auth.uid == adminUid || isAdmin());
      allow write: if isAdmin();
    }

    // User Profiles Collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().role == 'student' &&
        incoming().status == 'active';
      allow update: if (isAdmin() && isValidUserProfile(incoming())) ||
        (isOwner(userId) && isValidUserProfile(incoming()) &&
         incoming().uid == existing().uid &&
         incoming().role == existing().role &&
         incoming().status == existing().status);
      allow delete: if isAdmin();
    }

    // Tasks Collection
    match /tasks/{taskId} {
      allow get: if isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        isValidId(taskId) &&
        isValidTask(incoming()) &&
        incoming().id == taskId &&
        incoming().ownerUid == request.auth.uid;
      allow update: if isSignedIn() &&
        isValidTask(incoming()) &&
        (
          (existing().ownerUid == request.auth.uid && incoming().ownerUid == existing().ownerUid) ||
          isAdmin()
        );
      allow delete: if isSignedIn() &&
        (existing().ownerUid == request.auth.uid || isAdmin());
    }

    // Feedbacks Collection
    match /feedbacks/{feedbackId} {
      allow get: if isSignedIn() && (existing().userUid == request.auth.uid || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.userUid == request.auth.uid);
      allow create: if isSignedIn() &&
        isValidId(feedbackId) &&
        isValidFeedback(incoming()) &&
        incoming().id == feedbackId &&
        incoming().userUid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
